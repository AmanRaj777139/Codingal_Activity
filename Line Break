<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HTML Line Break Example</title>
</head>
<body>
  <p>
    This is a paragraph.<br />
    This text is after a line break.<br />
  </p>

  <!-- 
    The <br> tag is used to insert a single line break in the text.
    Unlike paragraphs (<p>), it does not add extra margin/space.
  -->
</body>
</html>
