<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HTML Heading and Paragraph Example</title>
</head>
<body>
  <!-- Headings: h1 to h6 define headings, with h1 being the highest level -->
  <h1>This is a Heading 1 (h1)</h1>
  <h2>This is a Heading 2 (h2)</h2>
  <h3>This is a Heading 3 (h3)</h3>

  <!-- Paragraph: contains blocks of text -->
  <p>This is a paragraph. It is used to display blocks of text in your webpage.</p>

</body>
</html>
