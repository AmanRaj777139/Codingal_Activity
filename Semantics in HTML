<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>HTML Semantics</title>
  
</head>
<body>

  <header>
    <h1>Welcome to My Website</h1>
    <p>This is the header section with the site title and intro</p>
  </header>

  <nav>
    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#articles">Articles</a></li>
      <li><a href="#about">About</a></li>
    </ul>
  </nav>

  <main>
    <article>
      <h2>Article Title</h2>
      <p>This is an article's main content.</p>
      <section>
        <h3>Section in Article</h3>
        <p>Further details inside a section.</p>
      </section>
    </article>

    <aside>
      <h3>Related Info</h3>
      <p>This aside contains complementary information or ads.</p>
    </aside>
  </main>

  <footer>
    <p>© 2024 My Website | Contact: info@example.com</p>
  </footer>

  <!-- 
    Semantic tags:
    header: Introductory content or navigation
    nav: Navigation links
    main: Primary page content
    article: Independent, self-contained content
    section: Thematic grouping of content
    aside: Related or tangential content
    footer: Footer content such as copyrights
  -->
</body>
</html>
